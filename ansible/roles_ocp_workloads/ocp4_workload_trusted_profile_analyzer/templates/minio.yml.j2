---
apiVersion: v1
kind: Secret
metadata:
  name: storage-credentials
  namespace: "{{ ocp4_workload_trusted_profile_analyzer_namespace }}"
type: Opaque
stringData:
  user: "{{ ocp4_workload_trusted_profile_analyzer_minio_root_user }}"
  password: "{{ ocp4_workload_trusted_profile_analyzer_minio_root_password }}"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tpa-minio
  namespace: "{{ ocp4_workload_trusted_profile_analyzer_namespace }}"
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: "{{ ocp4_workload_trusted_profile_analyzer_minio_pvc_size }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tpa-minio
  namespace: "{{ ocp4_workload_trusted_profile_analyzer_namespace }}"
  labels:
    app: tpa-minio
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tpa-minio
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: tpa-minio
    spec:
      containers:
      - name: minio
        image: "{{ ocp4_workload_trusted_profile_analyzer_minio_image }}"
        env:
        - name: MINIO_ROOT_USER
          valueFrom:
            secretKeyRef:
              name: storage-credentials
              key: user
        - name: MINIO_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: storage-credentials
              key: password
        - name: MINIO_DEFAULT_BUCKETS
          value: "{{ ocp4_workload_trusted_profile_analyzer_minio_bucket }}"
        ports:
        - name: api
          containerPort: 9000
        - name: console
          containerPort: 9001
        volumeMounts:
        - name: data
          mountPath: /bitnami/minio/data
        readinessProbe:
          httpGet:
            path: /minio/health/ready
            port: 9000
          initialDelaySeconds: 5
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /minio/health/live
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 20
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: tpa-minio
---
apiVersion: v1
kind: Service
metadata:
  name: "{{ ocp4_workload_trusted_profile_analyzer_minio_service_name }}"
  namespace: "{{ ocp4_workload_trusted_profile_analyzer_namespace }}"
  labels:
    app: tpa-minio
spec:
  selector:
    app: tpa-minio
  ports:
  - name: api
    port: 9000
    targetPort: 9000
  - name: console
    port: 9001
    targetPort: 9001
---
apiVersion: batch/v1
kind: Job
metadata:
  name: tpa-minio-create-bucket
  namespace: "{{ ocp4_workload_trusted_profile_analyzer_namespace }}"
  labels:
    app: tpa-minio
spec:
  backoffLimit: 6
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app: tpa-minio
        job: tpa-minio-create-bucket
    spec:
      restartPolicy: OnFailure
      containers:
      - name: mc
        image: "{{ ocp4_workload_trusted_profile_analyzer_minio_client_image }}"
        env:
        - name: MINIO_ROOT_USER
          valueFrom:
            secretKeyRef:
              name: storage-credentials
              key: user
        - name: MINIO_ROOT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: storage-credentials
              key: password
        - name: MINIO_ENDPOINT
          value: "http://{{ ocp4_workload_trusted_profile_analyzer_minio_service_name }}:9000"
        - name: BUCKET
          value: "{{ ocp4_workload_trusted_profile_analyzer_minio_bucket }}"
        command:
        - /bin/bash
        - -exc
        - |
          until mc alias set local "${MINIO_ENDPOINT}" "${MINIO_ROOT_USER}" "${MINIO_ROOT_PASSWORD}"; do
            sleep 5
          done
          mc mb --ignore-existing "local/${BUCKET}"
          mc anonymous set none "local/${BUCKET}" || true
          echo "Bucket ${BUCKET} ready"
